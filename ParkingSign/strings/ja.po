msgctxt "ParkingSign.STRINGS.BUILDING.STATUSITEMS.PARKINGSIGNACTIVE.NAME"
msgid "Active"
msgstr "作動中"

msgctxt "ParkingSign.STRINGS.BUILDING.STATUSITEMS.PARKINGSIGNACTIVE.TOOLTIP"
msgid "The Parking Sign is receiving a Green signal."
msgstr "停留所は<color=#00FF00>グリーン</color>信号を受信しています。"

msgctxt "ParkingSign.STRINGS.BUILDING.STATUSITEMS.PARKINGSIGNINACTIVE.NAME"
msgid "Inactive"
msgstr "停止中"

msgctxt "ParkingSign.STRINGS.BUILDING.STATUSITEMS.PARKINGSIGNINACTIVE.TOOLTIP"
msgid "The Parking Sign is not receiving a Green signal."
msgstr "停留所は<color=#00FF00>グリーン</color>信号を受信していません。"

msgctxt "ParkingSign.STRINGS.BUILDING.STATUSITEMS.PARKINGSIGNNOSTANDPOINT.NAME"
msgid "<color=#FF0000>No standing tile</color>"
msgstr "<color=#FF0000>立てる足場がありません</color>"

msgctxt "ParkingSign.STRINGS.BUILDING.STATUSITEMS.PARKINGSIGNNOSTANDPOINT.TOOLTIP"
msgid "<color=#FF0000>No tile where a Duplicant can stand was found within 10 tiles below this sign.</color>"
msgstr "<color=#FF0000>この看板の下方10タイル以内に、複製人間が立てる足場が見つかりません。</color>"

